:root {
  color-scheme: light;
  --evergreen: #183c32;
  --evergreen-2: #245142;
  --evergreen-3: #dce9df;
  --paper: #f4f2eb;
  --surface: #fffefa;
  --surface-2: #f8f7f1;
  --ink: #202a25;
  --muted: #65726a;
  --line: #dfe3d9;
  --rust: #a8472f;
  --rust-bg: #f6e6df;
  --brass: #8b681b;
  --brass-bg: #f4edd8;
  --blue: #315d7a;
  --blue-bg: #e6eef3;
  --green: #2c684d;
  --green-bg: #e2eee5;
  --shadow: 0 9px 28px rgb(23 43 33 / 8%);
  --radius: 12px;
  --font: 'Segoe UI', Arial, sans-serif;
  --mono: Consolas, 'Courier New', monospace;
}

* { box-sizing: border-box; }
html { min-width: 320px; background: var(--paper); }
body { margin: 0; color: var(--ink); font-family: var(--font); font-size: 15px; line-height: 1.5; }
button, input, select, textarea { font: inherit; }
button { color: inherit; }
input, textarea { caret-color: var(--evergreen); }
input::placeholder, textarea::placeholder { color: #69766d; opacity: 1; }
* { scrollbar-color: #aab7ac var(--surface-2); scrollbar-width: thin; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, a:focus-visible { outline: 3px solid var(--brass); outline-offset: 2px; }
::selection { color: #fffefa; background: var(--evergreen-2); }
a { color: var(--evergreen-2); }
.mono, .lot-code, .number { font-family: var(--mono); font-variant-numeric: tabular-nums; }

.app-shell { display: grid; grid-template-columns: 252px minmax(0, 1fr); min-height: 100vh; }
.sidebar { position: sticky; top: 0; display: flex; flex-direction: column; height: 100vh; padding: 23px 15px 16px; color: #f5f4ed; background: var(--evergreen); overflow-y: auto; z-index: 20; }
.brand { display: flex; align-items: center; gap: 11px; padding: 0 9px 23px; border-bottom: 1px solid rgb(255 255 255 / 13%); }
.brand-mark { display: grid; flex: none; width: 42px; height: 42px; place-items: center; border: 1px solid rgb(244 239 215 / 50%); border-radius: 9px; color: #f1d897; font-family: var(--mono); font-size: 12px; letter-spacing: -.03em; }
.brand-name { font-weight: 700; font-size: 15px; letter-spacing: .04em; }
.brand-sub { margin-top: 1px; color: #c4d1c8; font-size: 11px; }
.nav-section { margin-top: 23px; }
.nav-label { padding: 0 11px 8px; color: #abc0b4; font-size: 10px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
.nav-list { display: grid; gap: 3px; }
.nav-link { display: flex; align-items: center; gap: 11px; width: 100%; min-height: 44px; padding: 8px 11px; border: 0; border-radius: 7px; color: #e0e9e2; background: transparent; font-size: 14px; text-align: left; cursor: pointer; transition: background .16s ease, color .16s ease; }
.nav-link:hover { background: rgb(255 255 255 / 9%); }
.nav-link[aria-current="page"] { color: #fff; background: #2b5647; box-shadow: inset 2px 0 #e3c77d; }
.nav-link svg { flex: none; width: 17px; height: 17px; opacity: .92; }
.nav-count { margin-left: auto; min-width: 20px; padding: 1px 6px; border-radius: 99px; color: #f8e9bb; background: rgb(255 255 255 / 12%); text-align: center; font: 11px var(--mono); }
.sidebar-bottom { margin-top: auto; padding: 15px 8px 0; border-top: 1px solid rgb(255 255 255 / 13%); }
.user-card { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 8px; border-radius: 9px; background: rgb(255 255 255 / 8%); }
.avatar { display: grid; flex: none; width: 34px; height: 34px; place-items: center; border-radius: 50%; color: var(--evergreen); background: #e5d9b5; font-size: 12px; font-weight: 700; }
.user-meta { min-width: 0; flex: 1; }
.user-name { overflow: hidden; color: #fff; font-size: 13px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.user-role { color: #c2d0c6; font-size: 12px; }
.icon-button { display: inline-grid; flex: none; width: 44px; height: 44px; place-items: center; border: 1px solid transparent; border-radius: 7px; background: transparent; cursor: pointer; }
.icon-button:hover { background: rgb(20 37 29 / 7%); }
.icon-button svg { width: 17px; height: 17px; }
.sidebar .icon-button { color: #e8eee9; }

.main-column { min-width: 0; }
.topbar { position: sticky; top: 0; z-index: 15; display: flex; min-height: 66px; align-items: center; gap: 20px; padding: 10px 34px; border-bottom: 1px solid var(--line); background: var(--surface); }
.topbar-title { flex: 1; color: #5a695f; font-size: 12px; }
.global-search { position: relative; width: min(310px, 32vw); }
.global-search svg { position: absolute; top: 50%; left: 11px; width: 16px; height: 16px; color: #708078; transform: translateY(-50%); }
.global-search input { width: 100%; height: 36px; padding: 0 12px 0 36px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: var(--surface-2); }
.top-actions { display: flex; align-items: center; gap: 6px; }
.top-actions .icon-button { border-color: var(--line); background: var(--surface); }
.main-content { width: min(1500px, 100%); margin: 0 auto; padding: 30px 34px 52px; }
.page-heading { display: flex; align-items: flex-start; gap: 18px; margin-bottom: 24px; }
.page-heading h1 { margin: 0; color: #26382e; font-size: clamp(24px, 2.2vw, 31px); font-weight: 600; letter-spacing: -.035em; line-height: 1.16; }
.page-heading p { max-width: 680px; margin: 8px 0 0; color: var(--muted); }
.heading-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }

.button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 8px; padding: 10px 15px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: var(--surface); font-size: 14px; font-weight: 600; cursor: pointer; transition: background .15s ease, border-color .15s ease, transform .15s ease; }
.button:hover { border-color: #b9c7ba; background: #f7f8f2; }
.button:active { transform: translateY(1px); }
.button svg { width: 15px; height: 15px; }
.button-primary { border-color: var(--evergreen); color: #fff; background: var(--evergreen); }
.button-primary:hover { border-color: #2e604e; background: #2e604e; }
.button-danger { border-color: #d8b2a8; color: #8d3828; background: #fff8f5; }
.button-subtle { border-color: transparent; background: transparent; }
.button-small { min-height: 44px; padding: 8px 11px; font-size: 13px; }
.button:disabled { opacity: .45; cursor: not-allowed; }

.notice { display: flex; align-items: flex-start; gap: 10px; margin: 0 0 18px; padding: 12px 14px; border: 1px solid #e1d5b3; border-radius: 8px; color: #5c4d27; background: #fbf7e9; font-size: 12px; }
.notice svg { flex: none; width: 16px; height: 16px; margin-top: 1px; }
.notice strong { font-weight: 700; }
.notice-danger { border-color: #e7c0b7; color: #733627; background: #fcf0ec; }
.notice-success { border-color: #c6d9c8; color: #315c41; background: #eef6ee; }

.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; margin-bottom: 20px; }
.metric { min-width: 0; padding: 16px 17px 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
.metric-top { display: flex; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 12px; }
.metric-icon { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 7px; color: var(--evergreen-2); background: var(--evergreen-3); }
.metric-icon svg { width: 15px; height: 15px; }
.metric-value { margin-top: 11px; color: #21382d; font-size: 25px; font-weight: 600; letter-spacing: -.035em; line-height: 1.15; }
.metric-note { display: flex; align-items: center; gap: 5px; margin-top: 8px; color: #65736b; font-size: 12px; }
.metric-note strong { color: var(--green); }

.overview-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(270px, .8fr); gap: 16px; align-items: start; }
.panel { min-width: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
.panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 17px 19px 14px; border-bottom: 1px solid #e9ebe4; }
.panel-heading h2 { margin: 0; color: #25382e; font-size: 15px; font-weight: 600; letter-spacing: -.015em; }
.panel-heading p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
.panel-body { padding: 16px 19px; }
.queue-list { display: grid; }
.queue-item { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 14px; padding: 13px 0; border-bottom: 1px solid #eceee8; }
.queue-item:last-child { border-bottom: 0; }
.queue-main { min-width: 0; }
.queue-title { overflow: hidden; color: #29372f; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.queue-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 5px; color: #5d6c62; font-size: 13px; }
.queue-end { display: grid; justify-items: end; gap: 6px; }
.link-button { min-height: 44px; padding: 8px 10px; border: 0; border-radius: 5px; color: var(--evergreen-2); background: transparent; font-size: 14px; font-weight: 600; cursor: pointer; }
.link-button:hover { background: #eef3eb; text-decoration: underline; text-underline-offset: 3px; }
.status { display: inline-flex; min-height: 24px; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 4px; color: #59675d; background: #edf0e9; font-size: 12px; font-weight: 600; white-space: nowrap; }
.status::before { width: 5px; height: 5px; border-radius: 50%; background: currentColor; content: ''; }
.status-amber { color: #785b14; background: var(--brass-bg); }
.status-red { color: #923e2b; background: var(--rust-bg); }
.status-blue { color: #365e78; background: var(--blue-bg); }
.status-green { color: #316648; background: var(--green-bg); }
.status-neutral { color: #606b64; background: #eceee8; }
.lot-code { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; padding: 3px 7px; border: 1px solid #d8e0d5; border-radius: 4px; color: #24493b; background: #eff4ec; font-size: 12px; font-weight: 500; white-space: nowrap; }
.lot-code::before { width: 5px; height: 12px; border-radius: 1px; background: #bc8a31; content: ''; }
.activity-list { display: grid; }
.activity { display: grid; grid-template-columns: 20px minmax(0,1fr); gap: 10px; padding: 11px 0; }
.activity-mark { position: relative; display: grid; width: 20px; height: 20px; place-items: center; border-radius: 50%; color: var(--evergreen-2); background: #e5eee6; }
.activity-mark::after { position: absolute; top: 20px; bottom: -11px; left: 9px; width: 1px; background: #e1e6dd; content: ''; }
.activity:last-child .activity-mark::after { display: none; }
.activity-mark svg { width: 11px; height: 11px; }
.activity-text { color: #334139; font-size: 13px; }
.activity-time { margin-top: 3px; color: #5f6e64; font-size: 12px; }

.table-toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; padding: 16px; border-bottom: 1px solid #e8ebe4; background: var(--surface-2); }
.field-inline { position: relative; flex: 0 1 280px; min-width: 180px; max-width: 310px; }
.field-inline input { width: 100%; height: 44px; padding: 0 10px 0 33px; border: 1px solid #809180; border-radius: 6px; background: var(--surface); font-size: 14px; }
.field-inline svg { position: absolute; top: 50%; left: 10px; width: 15px; height: 15px; color: #708078; transform: translateY(-50%); }
.toolbar-select { height: 44px; max-width: 220px; padding: 0 29px 0 10px; border: 1px solid #809180; border-radius: 6px; color: #46544b; background: var(--surface); font-size: 14px; }
.filter-fields { display: flex; flex: 1 1 auto; flex-wrap: wrap; align-items: end; gap: 10px; min-width: 0; }
.filter-fields label { display: grid; gap: 5px; min-width: 140px; color: var(--muted); font-size: 12px; font-weight: 600; }
.filter-fields select { width: 100%; min-width: 140px; }
.toolbar-spacer { display: none; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; }
th { padding: 8px 14px; color: #526158; background: var(--surface-2); font-size: 13px; font-weight: 600; white-space: nowrap; }
th button { min-height: 44px; padding: 8px 4px; border: 0; border-radius: 4px; color: inherit; background: none; font: inherit; cursor: pointer; }
th button:hover { color: var(--evergreen-2); }
td { max-width: 340px; padding: 12px 14px; border-top: 1px solid #eceee8; color: #3d4941; font-size: 15px; vertical-align: middle; }
tr:hover td { background: #fcfcf8; }
td strong { color: #2b3930; font-weight: 600; }
.table-primary { display: grid; gap: 3px; }
.table-secondary { color: #5e6b62; font-size: 12px; }
.row-action { white-space: nowrap; }
.pagination { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 16px; border-top: 1px solid #eceee8; color: #56655b; font-size: 13px; }
.pagination .toolbar-select { height: 44px; }
.pagination .button { min-width: 44px; min-height: 44px; padding: 8px; font-size: 14px; }
.pagination-info { margin-right: auto; }
.empty-state { display: grid; min-height: 200px; place-items: center; padding: 30px; color: #69766e; text-align: center; }
.empty-state svg { width: 32px; height: 32px; margin-bottom: 10px; color: #829286; }
.empty-state strong { display: block; margin-bottom: 4px; color: #37473d; }

.detail-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .78fr); gap: 16px; align-items: start; }
.detail-layout-single { grid-template-columns: minmax(0, 1fr); }
.detail-main { display: grid; gap: 15px; min-width: 0; }
.detail-card { padding: 22px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
.detail-card h2 { margin: 0 0 16px; color: #2a3b31; font-size: 17px; font-weight: 600; }
.detail-title { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px; }
.detail-title h2 { flex: 1; margin: 0; font-size: 19px; letter-spacing: -.025em; }
.detail-title .status { margin-top: 2px; }
.detail-summary { margin: 11px 0 0; color: var(--muted); }
.detail-fields { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 22px 28px; margin: 24px 0 0; }
.detail-field dt { margin-bottom: 5px; color: #5c6b61; font-size: 13px; }
.detail-field dd { margin: 0; color: #35433a; font-size: 15px; font-weight: 500; overflow-wrap: anywhere; }
.timeline { display: grid; }
.timeline-item { display: grid; grid-template-columns: 15px minmax(0,1fr); gap: 10px; padding: 0 0 15px; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot { position: relative; width: 9px; height: 9px; margin: 5px 3px 0; border: 2px solid #85a08c; border-radius: 50%; background: #fff; }
.timeline-item:not(:last-child) .timeline-dot::after { position: absolute; top: 7px; bottom: -20px; left: 1px; width: 1px; background: #dce4da; content: ''; }
.timeline-text { color: #415047; font-size: 14px; }
.timeline-time { margin-top: 3px; color: #5f6e64; font-size: 12px; }
.detail-aside { display: grid; gap: 14px; }
.action-panel { padding: 17px; border: 1px solid #cad7ca; border-radius: var(--radius); background: #f4f8f1; }
.action-panel h2 { margin: 0 0 14px; color: #294538; font-size: 16px; }
.action-panel p { margin: 0 0 13px; color: #607066; font-size: 13px; }
.action-stack { display: grid; gap: 7px; }
.action-stack .button { width: 100%; }
.muted-box { padding: 13px; border: 1px solid var(--line); border-radius: 8px; color: #5f6e64; background: var(--surface-2); font-size: 13px; }
.history-list { display: grid; gap: 8px; margin: 0; padding-left: 17px; color: #536259; font-size: 13px; }

.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; }
.form-field { display: grid; align-content: start; gap: 7px; min-width: 0; }
.form-field.full { grid-column: 1 / -1; }
.form-field label { color: #37453c; font-size: 14px; font-weight: 600; }
.required { color: #a3402c; }
.form-field input, .form-field select, .form-field textarea { width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #809180; border-radius: 6px; color: var(--ink); background: #fff; font-size: 15px; }
.form-field input:hover, .form-field select:hover, .form-field textarea:hover { border-color: var(--evergreen-2); }
.form-field input[readonly] { color: #58675d; background: var(--surface-2); }
.form-field input[type="file"] { min-height: 46px; padding: 5px 7px; color: #526057; font-size: 13px; }
.form-field input[type="file"]::file-selector-button { min-height: 30px; margin-right: 10px; padding: 5px 10px; border: 1px solid #cfd8ce; border-radius: 5px; color: #30463a; background: #f5f7f1; font: inherit; font-weight: 600; cursor: pointer; }
.form-field textarea { min-height: 82px; resize: vertical; }
.field-hint { color: #5d6c63; font-size: 12px; }
.form-errors { margin-bottom: 18px; padding: 12px; border: 1px solid #e5c2b8; border-radius: 7px; color: #853b2b; background: #fff2ed; font-size: 14px; }
.form-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 26px; padding-top: 20px; border-top: 1px solid #e8ebe4; }
.field-checks { display: grid; grid-template-columns: repeat(auto-fit,minmax(210px,1fr)); gap: 8px; padding: 2px 0; }
.check-row { display: flex; min-height: 46px; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid #dfe5dc; border-radius: 6px; color: #405047; background: #fff; font-size: 14px; cursor: pointer; }
.check-row:hover { border-color: #a8b8aa; background: #f8faf6; }
.check-row:has(input:checked) { border-color: #8da792; background: #f0f6ef; }
.check-row:has(input:focus-visible) { outline: 3px solid var(--brass); outline-offset: 2px; }
.form-field .check-row input[type="checkbox"] { width: 18px; height: 18px; min-width: 18px; min-height: 18px; flex: none; margin: 0; padding: 0; accent-color: var(--evergreen-2); cursor: pointer; }

.modal-backdrop { position: fixed; inset: 0; z-index: 50; display: grid; align-items: center; justify-items: center; padding: 18px; background: rgb(20 31 25 / 47%); }
.modal { width: min(760px, 100%); max-height: min(90dvh, 900px); overflow: auto; border-radius: 13px; background: var(--surface); box-shadow: var(--shadow); }
.modal-head { position: sticky; top: 0; z-index: 1; display: flex; align-items: flex-start; gap: 14px; padding: 17px 20px; border-bottom: 1px solid var(--line); background: var(--surface); }
.modal-head h2 { flex: 1; margin: 0; color: #27392f; font-size: 17px; font-weight: 600; }
.modal-body { padding: 24px; }
.modal-close { width: 44px; height: 44px; margin: -7px -7px -7px 0; }
.confirm-copy { color: #526057; font-size: 13px; }
.confirm-copy strong { color: #2b3c32; }

.login-page { display: grid; min-height: 100vh; min-height: 100dvh; place-items: center; padding: 36px 20px; background: var(--paper); }
.login-panel { width: min(460px,100%); padding: 32px; border: 1px solid #cdd7ca; border-radius: 14px; background: var(--surface); }
.login-panel .brand { gap: 12px; padding: 0 0 26px; border-bottom: 1px solid var(--line); }
.login-panel .brand-mark { width: 46px; height: 46px; border-color: var(--evergreen); color: #f1d897; background: var(--evergreen); }
.login-panel .brand-name { color: var(--evergreen); font-size: 18px; letter-spacing: .015em; }
.login-panel .brand-sub { margin-top: 3px; color: #5f6e64; font-size: 13px; }
.login-box { width: 100%; padding-top: 27px; }
.login-box h1, .login-box h2 { margin: 0 0 24px; color: #26372e; font-size: 28px; font-weight: 600; letter-spacing: -.025em; line-height: 1.2; }
.login-box > p { margin: -12px 0 24px; color: #59685f; font-size: 14px; }
.login-box .form-field { margin-bottom: 20px; }
.login-box .form-field label { font-size: 14px; }
.login-box .form-field input { min-height: 48px; padding: 11px 13px; font-size: 16px; }
.login-error:not(:empty) { margin: 0 0 18px; color: #853b2b; font-size: 14px; }
.password-control { position: relative; }
.password-control input { padding-right: 52px !important; }
.password-toggle { position: absolute; top: 2px; right: 2px; display: grid; width: 44px; height: 44px; place-items: center; border: 0; border-radius: 5px; color: #52645a; background: transparent; cursor: pointer; }
.password-toggle svg { width: 19px; height: 19px; }
.password-toggle:hover { background: #eef2eb; }
.login-box .button-primary { width: 100%; min-height: 48px; margin-top: 4px; font-size: 15px; }
.forgot-link { display: block; margin: 12px auto -6px; font-size: 14px; }
.auth-modal { width: min(460px,100%); }
.auth-modal .form-grid { grid-template-columns: minmax(0,1fr); }
.auth-modal input[name="otp"] { min-height: 62px; padding-left: 22px; font-size: 28px; font-weight: 600; letter-spacing: .35em; text-align: center; font-variant-numeric: tabular-nums; }
.auth-modal .form-actions .button-primary { flex: 1; }
.otp-intro { margin: 0 0 17px; color: #44564b; }
.resend-row { display: flex; align-items: center; gap: 8px; margin-top: 15px; color: #64736a; font-size: 13px; }
.password-control .form-field input { padding-right: 48px; }
.upload-preview { margin-top: 8px; }
.bag-selection-list { display: grid; max-height: 230px; grid-template-columns: repeat(auto-fill,minmax(215px,1fr)); gap: 6px; overflow: auto; padding: 2px; }
.bag-selection-item { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 8px; border: 1px solid #dfe5dc; border-radius: 5px; background: #fff; }
.bag-selection-item.is-selected { border-color: #98b29d; background: #eef5ee; }
.bag-selection-item strong { color: #496153; font-size: 12px; font-weight: 600; white-space: nowrap; }
.attachment-link { display: inline-grid; gap: 5px; color: var(--evergreen-2); font-size: 12px; }
.attachment-image { display: block; width: min(280px,100%); max-height: 190px; object-fit: contain; object-position: left center; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); }
.attachment-file,.attachment-legacy { display: inline-flex; align-items: center; gap: 7px; color: var(--evergreen-2); overflow-wrap: anywhere; }
.attachment-file svg,.attachment-legacy svg { flex: none; width: 17px; height: 17px; }
.attachment-legacy { color: var(--muted); font-size: 12px; }
.attachment-viewer { display: grid; justify-items: center; gap: 16px; }
.attachment-viewer img { display: block; max-width: 100%; max-height: 70dvh; object-fit: contain; }
.attachment-viewer .attachment-image { width: 100%; max-height: 70dvh; border: 0; background: transparent; }
.attachment-viewer p { margin: 0; max-width: 100%; overflow-wrap: anywhere; }
.attachment-link { padding: 0; border: 0; background: transparent; text-align: left; cursor: zoom-in; }
.attachment-viewer { max-width: calc(100vw - 32px); max-height: 92dvh; padding: 20px; overflow: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
.attachment-viewer::backdrop { background: rgb(20 31 25 / 65%); }
.inbound-panel { margin-bottom: 24px; }
.archive-entry + .archive-entry { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
.archive-files { display: flex; flex-wrap: wrap; align-items: start; gap: 16px; }

.mobile-menu-button { display: none; }
.drawer-scrim { display: none; }
.toast-region { position: fixed; right: 20px; bottom: 20px; z-index: 90; display: grid; gap: 8px; width: min(360px, calc(100vw - 32px)); }
.toast { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; border: 1px solid #c9d9ca; border-radius: 8px; color: #294b36; background: #f3faf3; box-shadow: var(--shadow); font-size: 14px; animation: toast-in .24s cubic-bezier(.16,1,.3,1) both; }
.toast-error { border-color: #e3c0b6; color: #843d2e; background: #fff4ef; }
.toast-mark { flex: none; width: 7px; height: 7px; margin-top: 5px; border-radius: 50%; background: currentColor; }
@keyframes toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

@media (max-width: 1120px) {
  .app-shell { grid-template-columns: 220px minmax(0,1fr); }
  .sidebar { padding-right: 11px; padding-left: 11px; }
  .topbar { padding-right: 24px; padding-left: 24px; }
  .main-content { padding-right: 24px; padding-left: 24px; }
  .metric-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
@media (max-width: 820px) {
  .app-shell { display: block; }
  .sidebar { position: fixed; inset: 0 auto 0 0; width: min(290px, calc(100vw - 52px)); height: 100dvh; transform: translateX(-102%); transition: transform .2s ease; box-shadow: var(--shadow); }
  .sidebar.is-open { transform: translateX(0); }
  .drawer-scrim.is-visible { position: fixed; inset: 0; z-index: 19; display: block; border: 0; background: rgb(20 31 25 / 38%); }
  .mobile-menu-button { display: inline-grid; }
  .topbar { min-height: 58px; gap: 10px; padding: 9px 16px; }
  .topbar-title { display: none; }
  .global-search { width: auto; flex: 1; }
  .global-search input { height: 35px; }
  .main-content { padding: 23px 18px 42px; }
  .overview-grid, .detail-layout { grid-template-columns: 1fr; }
  .heading-actions { margin-left: 0; }
  .page-heading { flex-wrap: wrap; }
}
@media (max-width: 560px) {
  .button:not(.button-small) { min-height: 44px; }
  .icon-button { width: 44px; height: 44px; }
  .nav-link { min-height: 44px; }
  body { font-size: 15px; }
  .top-actions .hide-mobile { display: none; }
  .main-content { padding: 20px 13px 34px; }
  .metric-grid { gap: 8px; }
  .metric { padding: 13px 12px; }
  .metric-value { font-size: 21px; }
  .metric-top { font-size: 11px; }
  .panel-heading, .panel-body { padding-right: 13px; padding-left: 13px; }
  .table-toolbar { padding: 10px; }
  .field-inline { flex-basis: 100%; max-width: none; }
  .filter-fields { flex-basis: 100%; }
  .filter-fields label { flex: 1; min-width: 125px; }
  .toolbar-select { max-width: none; flex: 1; }
  .form-grid, .detail-fields { grid-template-columns: 1fr; }
  .form-field.full { grid-column: auto; }
  .modal-backdrop { padding: 8px; }
  .modal { max-height: 94dvh; }
  .modal-body { padding: 15px; }
  .modal-head { padding: 14px 15px; }
  .field-checks { grid-template-columns: minmax(0,1fr); }
  .queue-item { grid-template-columns: minmax(0,1fr); gap: 8px; }
  .queue-end { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; }
  .detail-card { padding: 18px; }
  .pagination { gap: 6px; }
  .pagination-info { flex-basis: 100%; }
  .login-page { padding: 24px 16px; }
  .login-panel { padding: 26px 22px; }
  .login-panel .brand { padding-bottom: 23px; }
  .login-box { padding-top: 24px; }
}
@media (prefers-reduced-motion: reduce) {
  .toast { animation: none; }
  .sidebar { transition: none; }
}
